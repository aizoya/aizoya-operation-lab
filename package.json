{
  "name": "aizoya-autonomous-operations",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "demo": "node --experimental-strip-types src/server.ts",
    "live": "node scripts/live-demo.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "build": "eve build",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "7.0.137",
    "eve": "0.80.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.19.2",
    "just-bash": "3.6.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "guarded-fetch": {
      "undici": "7.29.1"
    }
  }
}
